{
  "redirects": [
    {
      "source": "/obra/sliders-jujuy",
      "destination": "/obra/sliders-hamburger",
      "permanent": true
    },
    {
      "source": "/obra/sliders-rosas",
      "destination": "/obra/sliders-hamburger",
      "permanent": true
    },
    {
      "source": "/obra/sliders-funes",
      "destination": "/obra/sliders-hamburger",
      "permanent": true
    },
    {
      "source": "/obra/amstrong",
      "destination": "/obra/armstrong",
      "permanent": true
    },
    {
      "source": "/obra/fichines-pichincha",
      "destination": "/obra/fichines",
      "permanent": true
    },
    {
      "source": "/obra/local-flama",
      "destination": "/obra/flama",
      "permanent": true
    },
    {
      "source": "/obra/flama-local",
      "destination": "/obra/flama",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fzac-portfolio.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
